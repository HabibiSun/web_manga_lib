<nav class="reader-nav" id="reader-nav">
    <div class="reader-nav__container">
        <div class="reader-nav__left">
            <a href="/manga/<%= manga.id %>" class="reader-nav__title"><%= manga.title %></a>
        </div>
        <div class="reader-nav__center">
            <% if (previousChapter) { %>
                <a href="/manga/<%= manga.id %>/chapter/<%= previousChapter.id %>" class="reader-nav__arrow" title="Previous Chapter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </a>
            <% } %>

                <a href="#" class="reader-nav__chapter" id="chapters-toggle">
                    Глава <%= chapter.chapterNumber %>
                    <% if (chapter.title) { %>
                        <!-- Оборачиваем текстовое название в span с классом -->
                        <span class="chapter-title-text">- <%= chapter.title %></span>
                    <% } %>
                </a>

                <% if (nextChapter) { %>
                    <a href="/manga/<%= manga.id %>/chapter/<%= nextChapter.id %>" class="reader-nav__arrow" title="Next Chapter">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                <% } %>
        </div>
        <div class="reader-nav__right">
        </div>
    </div>
</nav>