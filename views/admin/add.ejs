<%- include('../partials/header', { title: 'Добавить мангу' }) %>
<div class="container">
    <div class="form-container" style="max-width: 700px;">
        <h1>Добавление новой манги</h1>
        <form action="/admin/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="title">Название</label>
                <input type="text" id="title" name="title" value="<%= oldInput.title || '' %>" placeholder="Магическая битва" required>
            </div>
            <div class="form-group">
                <label for="originalTitle">Оригинальное/Английское название</label>
                <input type="text" id="originalTitle" name="originalTitle" value="<%= oldInput.originalTitle || '' %>" placeholder="Jujutsu Kaisen">
            </div>
            <div class="form-group">
                <label for="folderName">Имя папки</label>
                <input type="text" id="folderName" name="folderName" value="<%= oldInput.folderName || '' %>" placeholder="Например: attack-on-titan" required>
            </div>
            <div class="form-group">
                <label for="author">Автор</label>
                <input type="text" id="author" name="author" value="<%= oldInput.author || '' %>" placeholder="Гэги Акута" required>
            </div>
            <div class="form-group">
                <label for="releaseYear">Год выпуска</label>
                <input type="number" id="releaseYear" name="releaseYear" value="<%= oldInput.releaseYear || '' %>" placeholder="2018">
            </div>
            <div class="form-group">
                <label for="description">Описание</label>
                <textarea id="description" name="description" rows="6" placeholder="Отличная манга" required><%= oldInput.description || '' %></textarea>
            </div>
            <div class="form-group">
                <label for="coverImage">Обложка (файл)</label>
                <input type="file" id="coverImage" name="coverImage" accept="image/jpg, image/jpeg, image/png, image/webp" required>
            </div>
            <div class="form-group">
                <label for="status">Статус</label>
                <select id="status" name="status">
                    <option value="ongoing">Продолжается</option>
                    <option value="completed">Завершен</option>
                    <option value="abandoned">Заброшен</option>
                </select>
            </div>
            <div class="form-group">
                <label>Жанры</label>
                <div class="checkbox-group">
                    <% if (typeof genres !== 'undefined' && genres.length > 0) { %>
                        <% genres.forEach(genre => { %>
                            <div class="checkbox-item">
                                <input
                                        type="checkbox"
                                        name="genres"
                                        id="genre-<%= genre.id %>"
                                        value="<%= genre.id %>"
                                        <% /* Проверяем, был ли этот жанр в предыдущем вводе */ %>
                                        <%= (oldInput.genres && oldInput.genres.includes(String(genre.id))) ? 'checked' : '' %>
                                >
                                <label for="genre-<%= genre.id %>"><%= genre.name %></label>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
            <button type="submit" class="btn btn--primary">Добавить мангу</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>