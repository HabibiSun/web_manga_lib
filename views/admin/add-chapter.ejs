<%- include('../partials/header', { title: 'Добавление главы' }) %>

<div class="container">
    <div class="form-container" style="max-width: 700px;">
        <h1>Добавить главу к манге: <br><em><%= mangaTitle %></em></h1>

        <form action="/admin/manga/<%= mangaId %>/add-chapter" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="chapterNumber">Номер главы</label>
                <input
                        type="number"
                        id="chapterNumber"
                        name="chapterNumber"
                        placeholder="Например: 12.5 или 34"
                        step="0.1"
                        value="<%= oldInput.chapterNumber || '' %>"
                        required
                >
            </div>

            <div class="form-group">
                <label for="chapterTitle">Название главы (необязательно)</label>
                <input
                        type="text"
                        id="chapterTitle"
                        name="chapterTitle"
                        placeholder="Например: Новое начало"
                        value="<%= oldInput.chapterTitle || '' %>"
                >
            </div>

            <div class="form-group">
                <label for="pages">Страницы главы (файлы)</label>
                <input
                        type="file"
                        id="pages"
                        name="pages"
                        accept="image/jpeg, image/png, image/webp"
                        multiple
                        required
                >
                <small>Выберите один или несколько файлов. Их порядок можно будет изменить позже. Файлы будут автоматически переименованы.</small>
            </div>

            <button type="submit" class="btn btn--primary">Добавить главу</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>