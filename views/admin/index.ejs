<%- include('../partials/header', { title: 'Админ-панель' }) %>
<div class="container">
    <div class="admin-header">
        <h1>Управление мангой</h1>
        <a href="/admin/add" class="btn btn--primary">Добавить новую мангу</a>
    </div>

    <div class="admin-search-filter">
        <form action="/admin" method="GET" class="admin-search-form">
            <input type="search" name="search" placeholder="Поиск по названию..." value="<%= currentSearch || '' %>">
            <button type="submit" class="btn btn--outline">Найти</button>
        </form>
    </div>

    <table class="admin-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Обложка</th>
            <th>Название</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        <% /* Ожидаем массив 'mangaList' */ %>
        <% if (typeof mangaList !== 'undefined' && mangaList.length > 0) { %>
            <% mangaList.forEach(manga => { %>
                <tr>
                    <td><%= manga.id %></td>
                    <td><img src="<%= manga.coverUrl %>" alt="Cover"></td>
                    <td>
                        <a href="/manga/<%= manga.id %>" class="admin-table-link">
                            <%= manga.title %>
                        </a>
                    </td>
                    <td class="actions">
                        <a href="/admin/manga/<%= manga.id %>/edit" class="btn btn--outline">Редактировать</a>
                        <a href="/admin/manga/<%= manga.id %>/chapters" class="btn btn--outline">Управлять главами</a>
                        <form
                                action="/admin/manga/<%= manga.id %>/delete"
                                method="POST"
                                style="display: inline;"
                                class="delete-form"
                                data-manga-title="<%= manga.title %>"
                        >
                            <button type="submit" class="btn btn--danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="4" style="text-align: center;">Манга не найдена.</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>